-- Operator logins of ${service_slug} (${environment}), generated by the Terraform module
-- operator-db-login. Desired state, safe to re-run. Run it as the cluster's master user
-- (rds_superuser) in ${database_name}:
--   psql "<connection to ${database_name} as the master user>" -v ON_ERROR_STOP=1 --single-transaction -f login.sql
--
-- - ${group}: a NOLOGIN group with no attributes, member of nothing; the service's own
--   migration grants it what operators may do. It gets CONNECT on ${database_name} here.
-- - One LOGIN role per listed operator: member of ${group} (INHERIT, no SET ROLE) and
--   rds_iam, so IAM database authentication is its only way in; no password, no attributes,
--   no other memberships, owns nothing, nobody else inherits it. Its sessions default to
--   idle_in_transaction_session_timeout ${idle_tx_seconds}s, so a transaction left open at the
--   prompt ends instead of holding rows the service's jobs wait for (an operator can still
--   change the setting inside their own session).
-- - Any other member of ${group} is taken out of it; an operator login (op_*) that is no
--   longer listed also loses LOGIN and rds_iam. Roles are kept, not dropped, so names in
--   audit rows keep pointing at the same person.
-- - The service's own users (${reserved}) can never be the group or a login.
SET LOCAL lock_timeout = '5s';

DO $fbx$
DECLARE
    grp        constant text   := '${group}';
    db         constant text   := '${database_name}';
    ops        constant text[] := ARRAY[${logins}];
    reserved   constant text[] := ARRAY[${reserved}];
    conn_limit constant int    := ${connection_limit};
    idle_tx    constant text   := '${idle_tx_seconds}s';
    op   text;
    bad  text;
BEGIN
    IF current_setting('server_version_num')::int < 160000 THEN
        RAISE EXCEPTION 'PostgreSQL 16 or later is required (membership INHERIT and SET options)';
    END IF;
    IF current_database() <> db THEN
        RAISE EXCEPTION 'run this in database %, not %', db, current_database();
    END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'rds_iam') THEN
        RAISE EXCEPTION 'role rds_iam is missing: IAM database authentication needs Aurora or RDS PostgreSQL';
    END IF;
    IF grp = ANY (reserved) OR ops && reserved THEN
        RAISE EXCEPTION 'the group and the operator logins must differ from the service users %', reserved;
    END IF;

    -- The group: no login, no attributes, member of nothing it could inherit from.
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = grp) THEN
        EXECUTE format('CREATE ROLE %I NOLOGIN', grp);
    END IF;
    EXECUTE format('ALTER ROLE %I NOLOGIN', grp);
    -- The master user may not change SUPERUSER, REPLICATION or BYPASSRLS, so attributes are checked, not set.
    IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = grp
                AND (rolsuper OR rolcreaterole OR rolcreatedb OR rolreplication OR rolbypassrls)) THEN
        RAISE EXCEPTION 'group % has role attributes (superuser, createrole, createdb, replication or bypassrls)', grp;
    END IF;
    SELECT string_agg(g.rolname, ', ') INTO bad
      FROM pg_auth_members m JOIN pg_roles g ON g.oid = m.roleid JOIN pg_roles r ON r.oid = m.member
     WHERE r.rolname = grp;
    IF bad IS NOT NULL THEN
        RAISE EXCEPTION 'group % is a member of % and would pass those privileges on to every operator', grp, bad;
    END IF;
    EXECUTE format('GRANT CONNECT ON DATABASE %I TO %I', db, grp);

    -- Members that are not listed operators leave the group; retired operator logins lose LOGIN.
    -- (The role that created the group keeps its ADMIN-only membership: no INHERIT, no SET.)
    FOR op IN
        SELECT r.rolname
          FROM pg_auth_members m JOIN pg_roles g ON g.oid = m.roleid JOIN pg_roles r ON r.oid = m.member
         WHERE g.rolname = grp AND (m.inherit_option OR m.set_option) AND r.rolname <> ALL (ops)
    LOOP
        EXECUTE format('REVOKE %I FROM %I', grp, op);
        IF op LIKE 'op\_%' THEN
            EXECUTE format('ALTER ROLE %I NOLOGIN', op);
            IF pg_has_role(op, 'rds_iam', 'MEMBER') THEN
                EXECUTE format('REVOKE rds_iam FROM %I', op);
            END IF;
            RAISE NOTICE 'operator login % retired: no LOGIN, not in %', op, grp;
        ELSE
            RAISE WARNING 'role % was a member of % and was taken out of it', op, grp;
        END IF;
    END LOOP;
    -- REVOKE only removes what the current role granted: a membership someone else granted stays,
    -- so stop rather than leave it.
    SELECT string_agg(format('%s (granted by %s)', r.rolname, gr.rolname), ', ') INTO bad
      FROM pg_auth_members m JOIN pg_roles g ON g.oid = m.roleid JOIN pg_roles r ON r.oid = m.member
      JOIN pg_roles gr ON gr.oid = m.grantor
     WHERE g.rolname = grp AND (m.inherit_option OR m.set_option) AND r.rolname <> ALL (ops);
    IF bad IS NOT NULL THEN
        RAISE EXCEPTION 'could not take % out of %; only its grantor can revoke it', bad, grp;
    END IF;

    FOREACH op IN ARRAY ops LOOP
        IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = op) THEN
            -- An existing role is only taken over if it is nothing but an operator login.
            SELECT string_agg(g.rolname, ', ') INTO bad
              FROM pg_auth_members m JOIN pg_roles g ON g.oid = m.roleid JOIN pg_roles r ON r.oid = m.member
             WHERE r.rolname = op AND g.rolname NOT IN (grp, 'rds_iam');
            IF bad IS NOT NULL THEN
                RAISE EXCEPTION 'role % is also a member of % and is not just an operator login', op, bad;
            END IF;
            SELECT string_agg(r.rolname, ', ') INTO bad
              FROM pg_auth_members m JOIN pg_roles g ON g.oid = m.roleid JOIN pg_roles r ON r.oid = m.member
             WHERE g.rolname = op AND (m.inherit_option OR m.set_option);
            IF bad IS NOT NULL THEN
                RAISE EXCEPTION 'role % is used by % (INHERIT or SET); a login must belong to one person', op, bad;
            END IF;
            IF EXISTS (SELECT 1 FROM pg_class c JOIN pg_roles r ON r.oid = c.relowner WHERE r.rolname = op)
               OR EXISTS (SELECT 1 FROM pg_namespace n JOIN pg_roles r ON r.oid = n.nspowner WHERE r.rolname = op)
               OR EXISTS (SELECT 1 FROM pg_proc p JOIN pg_roles r ON r.oid = p.proowner WHERE r.rolname = op) THEN
                RAISE EXCEPTION 'role % owns objects in %; an operator login owns nothing', op, db;
            END IF;
        ELSE
            EXECUTE format('CREATE ROLE %I LOGIN', op);
        END IF;
        EXECUTE format('ALTER ROLE %I LOGIN INHERIT CONNECTION LIMIT %s PASSWORD NULL', op, conn_limit);
        IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = op
                    AND (rolsuper OR rolcreaterole OR rolcreatedb OR rolreplication OR rolbypassrls)) THEN
            RAISE EXCEPTION 'role % has role attributes (superuser, createrole, createdb, replication or bypassrls)', op;
        END IF;
        EXECUTE format('ALTER ROLE %I SET idle_in_transaction_session_timeout = %L', op, idle_tx);
        EXECUTE format('GRANT rds_iam TO %I', op);
        EXECUTE format('GRANT %I TO %I WITH INHERIT TRUE, SET FALSE', grp, op);
    END LOOP;
END
$fbx$;
