-- Operator logins of ${service_slug} (${environment}), generated by the Terraform module
-- operator-db-login. Desired state, safe to re-run. Run it as the cluster's master user
-- (rds_superuser) in ${database_name}. The file carries its own BEGIN and COMMIT, so psql must
-- not wrap it in another transaction:
--   psql "<connection to ${database_name} as the master user>" -v ON_ERROR_STOP=1 -f login.sql
--
-- - ${group}: a NOLOGIN group with no attributes, member of nothing, marked with the comment
--   '${group_mark}'. The service's own migration grants it what operators may do.
--   It gets CONNECT on ${database_name} here.
-- - One login per listed operator, marked with the comment 'operator-db-login ${group}: <their
--   Identity Center user name>': member of ${group} and of rds_iam (both INHERIT, no SET, no
--   ADMIN), so it signs in with IAM database authentication but can SET ROLE to no other role.
--   No password, no attributes, no other membership, nobody else is a member of it. Each run sets
--   its role-wide idle_in_transaction_session_timeout (${idle_tx_seconds}s) and pgaudit.log
--   (read,write,ddl,role). createrole_self_grant is off for the run, so the master gets no
--   membership of its own in the roles it creates beyond PostgreSQL's ADMIN row.
-- - The SQL only adopts roles that carry its mark. It stops, and its transaction rolls back,
--   when a listed login was retired, was made for another person or another group, or was changed
--   outside this SQL (no rds_iam, rds_iam with SET or ADMIN, LOGIN taken away, an extra membership
--   or member, a role it can SET ROLE to or grant, a per-database setting, a setting it does not
--   manage, or any object it owns or privilege it holds in any database), and when the group has a
--   member it did not add. The DBA looks at the evidence before anything is repaired.
-- - A marked login of ${group} that is no longer listed loses LOGIN, rds_iam and ${group}, and is
--   marked retired. Roles are kept, not dropped, and a retired login is never enabled again.
-- - The service's own users (${reserved}) can never be the group or a login.
%{ if read_only ~}
-- - Read only: each login defaults every transaction to read only. Transaction 1 checks the
--   group's mark, takes LOGIN away from every login of ${group} and commits. Transaction 2 makes
--   the desired state, then stops when any login can change anything in ${database_name} (as
--   PostgreSQL decides it: the login's own grants, the group's, rds_iam's and PUBLIC's): CREATE on
--   the database or a schema, a write privilege on a table, column or sequence, a default
--   privilege that would give one on a future table, sequence or schema, a large object it may
--   write, ownership, or EXECUTE on a SECURITY DEFINER function. Only when the check passes does
--   it give LOGIN back; when anything stops it, the logins stay disabled (sessions already open
--   keep running). Re-run it after each release of the service.
%{ endif ~}
%{ if read_only ~}

-- Transaction 1 of 2: no login of ${group} can connect until transaction 2 has passed its check.
BEGIN;
SET LOCAL lock_timeout = '5s';

DO $fbx$
DECLARE
    db       constant text := '${database_name}';
    grp      constant text := '${group}';
    grp_mark constant text := '${group_mark}';
    prefix   constant text := 'operator-db-login ${group}: ';
    op       text;
BEGIN
    IF current_database() <> db THEN
        RAISE EXCEPTION 'run this in database %, not %', db, current_database();
    END IF;
    -- Another instance's group (an operator one, say) is left alone.
    IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = grp)
       AND shobj_description(grp::regrole::oid, 'pg_authid') IS DISTINCT FROM grp_mark THEN
        RAISE EXCEPTION 'role % exists but this module did not create it as a read-only group (its comment is %, not %); each module instance, operator or read-only, needs its own operator_group_role. No role was touched', grp, coalesce(quote_literal(shobj_description(grp::regrole::oid, 'pg_authid')), 'empty'), quote_literal(grp_mark);
    END IF;
    FOR op IN
        SELECT r.rolname FROM pg_roles r
         WHERE r.rolcanlogin AND starts_with(coalesce(shobj_description(r.oid, 'pg_authid'), ''), prefix)
    LOOP
        EXECUTE format('ALTER ROLE %I NOLOGIN', op);
    END LOOP;
END
$fbx$;

COMMIT;

-- Transaction 2 of 2: desired state and the read-only check; LOGIN comes back only if it passes.
%{ endif ~}
BEGIN;
SET LOCAL lock_timeout = '5s';
SET LOCAL createrole_self_grant = '';

DO $fbx$
DECLARE
    grp        constant text   := '${group}';
    db         constant text   := '${database_name}';
    ops        constant text[] := ARRAY[${logins}];
    users      constant text[] := ARRAY[${users}];
    reserved   constant text[] := ARRAY[${reserved}];
    conn_limit constant int    := ${connection_limit};
    idle_tx    constant text   := '${idle_tx_seconds}s';
    audit_log  constant text   := 'read,write,ddl,role';
    ro         constant boolean := ${read_only};
    grp_mark   constant text   := '${group_mark}';
    prefix     constant text   := 'operator-db-login ${group}: ';
    -- What a stop leaves behind, for the messages below.
    undone     constant text   := '%{ if read_only }This transaction was rolled back; the read-only logins stay without LOGIN (the first transaction took it away) until a run passes%{ else }This transaction was rolled back, so nothing was changed%{ endif }';
    -- Role-wide settings this SQL sets on each login (and sets again on every run).
    managed    constant text[] := ARRAY['idle_in_transaction_session_timeout', 'pgaudit.log', 'default_transaction_read_only'];
    master     constant oid    := (SELECT oid FROM pg_roles WHERE rolname = current_user);
    op   text;
    usr  text;
    mark text;
    cmt  text;
    bad  text;
BEGIN
    IF current_setting('server_version_num')::int < 160000 THEN
        RAISE EXCEPTION 'PostgreSQL 16 or later is required (membership INHERIT and SET options)';
    END IF;
    IF current_database() <> db THEN
        RAISE EXCEPTION 'run this in database %, not %', db, current_database();
    END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'rds_iam') THEN
        RAISE EXCEPTION 'role rds_iam is missing: IAM database authentication needs Aurora or RDS PostgreSQL';
    END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_settings WHERE name = 'pgaudit.log') THEN
        RAISE EXCEPTION 'pgaudit is not loaded, so pgaudit.log cannot be set on the logins: add pgaudit to shared_preload_libraries in the cluster parameter group (aurora-postgresql pgaudit_enabled = true), reboot the instances, then run this again';
    END IF;
    IF grp = ANY (reserved) OR ops && reserved THEN
        RAISE EXCEPTION 'the group and the operator logins must differ from the service users %', reserved;
    END IF;
    IF cardinality(ops) <> cardinality(users) THEN
        RAISE EXCEPTION 'every login needs its Identity Center user name';
    END IF;

    -- 1. The group, if it exists: made by this SQL, and holding only what this SQL put there.
    IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = grp) THEN
        cmt := shobj_description(grp::regrole::oid, 'pg_authid');
        IF cmt IS DISTINCT FROM grp_mark THEN
            RAISE EXCEPTION 'role % exists but this module did not create it (its comment is %, not %); each module instance, operator or read-only, needs its own operator_group_role', grp, coalesce(quote_literal(cmt), 'empty'), quote_literal(grp_mark);
        END IF;
        -- The master user may not change SUPERUSER, REPLICATION or BYPASSRLS, so attributes are checked, not set.
        IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = grp
                    AND (rolsuper OR rolcreaterole OR rolcreatedb OR rolreplication OR rolbypassrls)) THEN
            RAISE EXCEPTION 'group % has role attributes (superuser, createrole, createdb, replication or bypassrls)', grp;
        END IF;
        SELECT string_agg(g.rolname, ', ') INTO bad
          FROM pg_auth_members m JOIN pg_roles g ON g.oid = m.roleid
         WHERE m.member = grp::regrole::oid;
        IF bad IS NOT NULL THEN
            RAISE EXCEPTION 'group % is a member of % and would pass those privileges on to every operator', grp, bad;
        END IF;
        -- Allowed members: the master's own ADMIN row that PostgreSQL 16 adds when a CREATEROLE user
        -- creates a role (grantor 10, the bootstrap superuser; no INHERIT, no SET), and this group's
        -- marked logins as this SQL grants them. Anything else stops the run. createrole_self_grant
        -- is off above, so this SQL never adds a second row of the master's itself.
        SELECT string_agg(format('%s (granted by %s, admin %s, inherit %s, set %s)', r.rolname, gr.rolname,
                                 m.admin_option, m.inherit_option, m.set_option), ', ') INTO bad
          FROM pg_auth_members m JOIN pg_roles r ON r.oid = m.member JOIN pg_roles gr ON gr.oid = m.grantor
         WHERE m.roleid = grp::regrole::oid
           AND NOT (m.member = master AND m.grantor = 10 AND m.admin_option AND NOT m.inherit_option AND NOT m.set_option)
           AND NOT (r.rolname <> ALL (reserved)
                    AND starts_with(coalesce(shobj_description(r.oid, 'pg_authid'), ''), prefix)
                    AND m.grantor = master AND m.inherit_option AND NOT m.set_option AND NOT m.admin_option);
        IF bad IS NOT NULL THEN
            RAISE EXCEPTION 'group % has members this module did not add the way it adds them: %. %', grp, bad, undone;
        END IF;
        SELECT string_agg(s.objid::text, ', ') INTO bad
          FROM pg_shdepend s
         WHERE s.refclassid = 'pg_authid'::regclass AND s.refobjid = grp::regrole::oid
           AND s.deptype = 'o' AND s.classid = 'pg_largeobject'::regclass;
        IF bad IS NOT NULL THEN
            RAISE EXCEPTION 'group % owns large objects %. %', grp, bad, undone;
        END IF;
    END IF;

    -- 2. Listed logins that exist: made by this SQL for the same person and group, and unchanged.
    FOREACH op IN ARRAY ops LOOP
        CONTINUE WHEN NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = op);
        usr  := users[array_position(ops, op)];
        mark := prefix || usr;
        cmt  := shobj_description(op::regrole::oid, 'pg_authid');
        IF cmt IS NULL OR NOT starts_with(cmt, 'operator-db-login ') THEN
            RAISE EXCEPTION 'role % exists but this module did not create it (no operator-db-login comment); give % another login name', op, usr;
        ELSIF cmt = mark || ' (retired)' THEN
            RAISE EXCEPTION 'login % was retired; a retired login is never enabled again: give % a new login name', op, usr;
        ELSIF NOT starts_with(cmt, prefix) THEN
            RAISE EXCEPTION 'login % belongs to another group (its comment is %); a login belongs to one group, so give % another login name', op, quote_literal(cmt), usr;
        ELSIF cmt <> mark THEN
            RAISE EXCEPTION 'login % was made for someone else (its comment is %), not for %; a login belongs to one person, so give % a new login name', op, quote_literal(cmt), usr, usr;
        END IF;

        SELECT string_agg(what, '; ') INTO bad FROM (
            SELECT 'it has role attributes (superuser, createrole, createdb, replication or bypassrls)' AS what
              FROM pg_roles r WHERE r.rolname = op
               AND (r.rolsuper OR r.rolcreaterole OR r.rolcreatedb OR r.rolreplication OR r.rolbypassrls)
            UNION ALL
            SELECT 'it is not in rds_iam'
              FROM pg_roles r WHERE r.rolname = op AND NOT pg_has_role(r.oid, 'rds_iam', 'MEMBER')
            UNION ALL
            SELECT 'it cannot log in (NOLOGIN set outside this SQL)'
              FROM pg_roles r WHERE r.rolname = op AND NOT r.rolcanlogin AND NOT ro
            UNION ALL
            SELECT format('it is not in %s', grp)
             WHERE NOT EXISTS (SELECT 1 FROM pg_auth_members m JOIN pg_roles g ON g.oid = m.roleid
                                WHERE g.rolname = grp AND m.member = op::regrole::oid)
            UNION ALL
            SELECT format('it is a member of %s', g.rolname)
              FROM pg_auth_members m JOIN pg_roles g ON g.oid = m.roleid
             WHERE m.member = op::regrole::oid AND g.rolname NOT IN (grp, 'rds_iam')
            UNION ALL
            -- This SQL grants rds_iam without SET or ADMIN, so a login cannot act as rds_iam (and
            -- make objects rds_iam owns, which every login has the privileges of).
            SELECT format('its rds_iam membership has SET or ADMIN (granted by %s, admin %s, set %s)', gr.rolname, m.admin_option, m.set_option)
              FROM pg_auth_members m JOIN pg_roles gr ON gr.oid = m.grantor
             WHERE m.roleid = 'rds_iam'::regrole AND m.member = op::regrole::oid AND (m.admin_option OR m.set_option)
            UNION ALL
            -- Any route to another role: SET along a chain of memberships, or ADMIN held by a role
            -- the login belongs to (an ADMIN that rds_iam holds lets every login grant that role
            -- to itself).
            SELECT format('it can %s role %s', CASE WHEN pg_has_role(op, r.oid, 'SET') THEN 'SET ROLE to' ELSE 'grant' END, r.rolname)
              FROM pg_roles r
             WHERE r.rolname <> op AND (pg_has_role(op, r.oid, 'SET') OR pg_has_role(op, r.oid, 'MEMBER WITH ADMIN OPTION'))
            UNION ALL
            SELECT format('%s is a member of it (granted by %s, admin %s, inherit %s, set %s)', r.rolname, gr.rolname,
                          m.admin_option, m.inherit_option, m.set_option)
              FROM pg_auth_members m JOIN pg_roles r ON r.oid = m.member JOIN pg_roles gr ON gr.oid = m.grantor
             WHERE m.roleid = op::regrole::oid
               AND NOT (m.member = master AND m.grantor = 10 AND m.admin_option AND NOT m.inherit_option AND NOT m.set_option)
            UNION ALL
            SELECT format('it has settings for database %s: %s', coalesce(d.datname, s.setdatabase::text), array_to_string(s.setconfig, ', '))
              FROM pg_db_role_setting s LEFT JOIN pg_database d ON d.oid = s.setdatabase
             WHERE s.setrole = op::regrole::oid AND s.setdatabase <> 0
            UNION ALL
            SELECT format('it has a role-wide setting this SQL does not manage: %s', c.setting)
              FROM pg_db_role_setting s, unnest(s.setconfig) AS c(setting)
             WHERE s.setrole = op::regrole::oid AND s.setdatabase = 0
               AND split_part(c.setting, '=', 1) <> ALL (managed)
            UNION ALL
            -- pg_shdepend lists, for every database of the cluster, what a role owns (o), the privileges
            -- granted to it (a: tables, columns, schemas, databases, functions, large objects, default
            -- privileges) and the policies that name it (r).
            SELECT format('it %s %s in %s', CASE s.deptype WHEN 'o' THEN 'owns' WHEN 'a' THEN 'holds privileges on' ELSE 'is named by' END,
                          CASE WHEN s.dbid IN (0, (SELECT oid FROM pg_database WHERE datname = current_database()))
                               THEN pg_describe_object(s.classid, s.objid, s.objsubid)
                               ELSE format('%s %s', s.classid::regclass, s.objid) END,
                          CASE WHEN s.dbid = 0 THEN 'the cluster' ELSE format('database %s', coalesce(d.datname, s.dbid::text)) END)
              FROM pg_shdepend s LEFT JOIN pg_database d ON d.oid = s.dbid
             WHERE s.refclassid = 'pg_authid'::regclass AND s.refobjid = op::regrole::oid
        ) f;
        IF bad IS NOT NULL THEN
            RAISE EXCEPTION 'login % (%) was changed outside this SQL: %. %; check the database log (pgaudit role class) for who did it, then fix it by hand or retire the login', op, usr, bad, undone;
        END IF;
    END LOOP;

    -- 3. Retire every marked login of this group that is no longer listed and still has LOGIN,
    -- rds_iam or the group, whether or not it is still a member.
    FOR op, cmt IN
        SELECT r.rolname, shobj_description(r.oid, 'pg_authid')
          FROM pg_roles r
         WHERE starts_with(coalesce(shobj_description(r.oid, 'pg_authid'), ''), prefix)
           AND r.rolname <> ALL (ops)
           AND (r.rolcanlogin OR pg_has_role(r.oid, 'rds_iam', 'MEMBER')
                OR EXISTS (SELECT 1 FROM pg_auth_members m JOIN pg_roles g ON g.oid = m.roleid
                            WHERE g.rolname = grp AND m.member = r.oid)
                OR shobj_description(r.oid, 'pg_authid') NOT LIKE '% (retired)')
    LOOP
        EXECUTE format('ALTER ROLE %I NOLOGIN', op);
        -- PostgreSQL 16 records as grantor the role the master holds ADMIN on rds_iam through: the
        -- master itself, or a role it has the privileges of (rds_superuser, say). REVOKE picks the
        -- same grantor.
        IF EXISTS (SELECT 1 FROM pg_auth_members m JOIN pg_roles g ON g.oid = m.roleid
                    WHERE g.rolname = 'rds_iam' AND m.member = op::regrole::oid AND pg_has_role(master, m.grantor, 'USAGE')) THEN
            EXECUTE format('REVOKE rds_iam FROM %I', op);
        END IF;
        IF EXISTS (SELECT 1 FROM pg_auth_members m JOIN pg_roles g ON g.oid = m.roleid
                    WHERE g.rolname = grp AND m.member = op::regrole::oid AND m.grantor = master) THEN
            EXECUTE format('REVOKE %I FROM %I', grp, op);
        END IF;
        IF cmt NOT LIKE '% (retired)' THEN
            mark := cmt;
            EXECUTE format('COMMENT ON ROLE %I IS %L', op, mark || ' (retired)');
        END IF;
        IF pg_has_role(op, 'rds_iam', 'MEMBER') THEN
            RAISE EXCEPTION 'could not take retired login % out of rds_iam; only its grantor can revoke it', op;
        END IF;
        RAISE NOTICE 'operator login % retired: no LOGIN, not in rds_iam or %', op, grp;
    END LOOP;

    -- 4. Desired state.
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = grp) THEN
        EXECUTE format('CREATE ROLE %I NOLOGIN', grp);
        EXECUTE format('COMMENT ON ROLE %I IS %L', grp, grp_mark);
    END IF;
    EXECUTE format('ALTER ROLE %I NOLOGIN', grp);
    EXECUTE format('GRANT CONNECT ON DATABASE %I TO %I', db, grp);

    FOREACH op IN ARRAY ops LOOP
        usr := users[array_position(ops, op)];
        IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = op) THEN
            EXECUTE format('CREATE ROLE %I NOLOGIN', op);
            EXECUTE format('COMMENT ON ROLE %I IS %L', op, prefix || usr);
        END IF;
        -- PASSWORD NULL every run: the master user cannot see whether a login has a password
        -- (pg_roles masks it and pg_authid needs a superuser), so it cannot stop on one.
        EXECUTE format('ALTER ROLE %I %s INHERIT CONNECTION LIMIT %s PASSWORD NULL', op, CASE WHEN ro THEN 'NOLOGIN' ELSE 'LOGIN' END, conn_limit);
        EXECUTE format('ALTER ROLE %I SET idle_in_transaction_session_timeout = %L', op, idle_tx);
        EXECUTE format('ALTER ROLE %I SET pgaudit.log = %L', op, audit_log);
        IF ro THEN
            EXECUTE format('ALTER ROLE %I SET default_transaction_read_only = on', op);
        ELSE
            EXECUTE format('ALTER ROLE %I RESET default_transaction_read_only', op);
        END IF;
        EXECUTE format('GRANT rds_iam TO %I WITH INHERIT TRUE, SET FALSE', op);
        EXECUTE format('GRANT %I TO %I WITH INHERIT TRUE, SET FALSE', grp, op);
    END LOOP;

    -- 5. Read only: what each login can do, as PostgreSQL decides it (its own grants and those of
    -- the group, rds_iam and PUBLIC), outside the system schemas. A session default can be changed
    -- by its login, so the privileges are what keeps these logins from writing.
    IF ro THEN
        SELECT string_agg(format('%s (%s)', what, whos), '; ') INTO bad FROM (
            SELECT what, string_agg(who, ', ' ORDER BY who) AS whos FROM (
                SELECT w.who, format('CREATE on database %I', db) AS what
                  FROM unnest(ops) AS w(who)
                 WHERE has_database_privilege(w.who, db, 'CREATE')
                UNION ALL
                SELECT w.who, format('CREATE on schema %I', n.nspname)
                  FROM unnest(ops) AS w(who), pg_namespace n
                 WHERE n.nspname NOT LIKE 'pg\_%' AND n.nspname <> 'information_schema'
                   AND has_schema_privilege(w.who, n.oid, 'CREATE')
                UNION ALL
                SELECT w.who, format('a write privilege on %s', c.oid::regclass)
                  FROM unnest(ops) AS w(who), pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
                 WHERE n.nspname NOT LIKE 'pg\_%' AND n.nspname <> 'information_schema'
                   AND CASE WHEN c.relkind IN ('r', 'p', 'v', 'm', 'f')
                            THEN has_table_privilege(w.who, c.oid, 'INSERT,UPDATE,DELETE,TRUNCATE,REFERENCES,TRIGGER')
                                 OR has_any_column_privilege(w.who, c.oid, 'INSERT,UPDATE,REFERENCES') END
                UNION ALL
                SELECT w.who, format('USAGE or UPDATE on sequence %s', c.oid::regclass)
                  FROM unnest(ops) AS w(who), pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
                 WHERE n.nspname NOT LIKE 'pg\_%' AND n.nspname <> 'information_schema'
                   -- CASE: has_sequence_privilege fails on anything but a sequence, whatever order the
                   -- planner evaluates the conditions in.
                   AND CASE WHEN c.relkind = 'S' THEN has_sequence_privilege(w.who, c.oid, 'USAGE,UPDATE') END
                UNION ALL
                -- A SECURITY DEFINER function runs as its owner. A function returning event_trigger is
                -- exempt: it runs only from an event trigger, which only a superuser can create (pgaudit's
                -- own two functions are such). A trigger function is not: a login could attach it to a
                -- temporary table it owns. A member of an extension is exempt only when the extension's
                -- owner is not a service user and owns no schema of the database: a service role could
                -- otherwise add its own function to an extension it created.
                SELECT w.who, format('EXECUTE on SECURITY DEFINER function %s', p.oid::regprocedure)
                  FROM unnest(ops) AS w(who), pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
                 WHERE n.nspname NOT LIKE 'pg\_%' AND n.nspname <> 'information_schema'
                   AND p.prosecdef AND p.prorettype <> 'event_trigger'::regtype
                   AND NOT EXISTS (
                       SELECT 1 FROM pg_depend d JOIN pg_extension e ON e.oid = d.refobjid
                        WHERE d.classid = 'pg_proc'::regclass AND d.objid = p.oid AND d.deptype = 'e'
                          AND d.refclassid = 'pg_extension'::regclass
                          AND e.extowner::regrole::text <> ALL (reserved)
                          AND NOT EXISTS (SELECT 1 FROM pg_namespace sn
                                           WHERE sn.nspowner = e.extowner
                                             AND sn.nspname NOT LIKE 'pg\_%' AND sn.nspname <> 'information_schema'))
                   AND has_function_privilege(w.who, p.oid, 'EXECUTE')
                UNION ALL
                -- Default privileges: what a table, sequence or schema created later would give.
                SELECT CASE WHEN a.grantee = 0 THEN 'PUBLIC' ELSE a.grantee::regrole::text END,
                       format('default %s on new %s%s of %s', a.privilege_type,
                              CASE d.defaclobjtype WHEN 'r' THEN 'tables' WHEN 'S' THEN 'sequences' ELSE 'schemas' END,
                              CASE WHEN d.defaclnamespace = 0 THEN '' ELSE format(' in schema %s', d.defaclnamespace::regnamespace) END,
                              d.defaclrole::regrole)
                  FROM pg_default_acl d, aclexplode(d.defaclacl) a
                 WHERE (a.grantee = 0 OR a.grantee::regrole::text = ANY (ops || ARRAY[grp, 'rds_iam']))
                   AND ((d.defaclobjtype = 'r' AND a.privilege_type IN ('INSERT', 'UPDATE', 'DELETE', 'TRUNCATE', 'REFERENCES', 'TRIGGER'))
                     OR (d.defaclobjtype = 'S' AND a.privilege_type IN ('USAGE', 'UPDATE'))
                     OR (d.defaclobjtype = 'n' AND a.privilege_type = 'CREATE'))
                UNION ALL
                -- Large objects: PostgreSQL 16 has no has_largeobject_privilege, so read the owner and the
                -- ACL. A login may write a large object owned by, or with UPDATE granted to, any role it
                -- has the privileges of (itself, the group, rds_iam, or a role they inherit), or PUBLIC.
                SELECT w.who, format('UPDATE on large object %s (owned by %s)', l.oid, l.lomowner::regrole)
                  FROM unnest(ops) AS w(who), pg_largeobject_metadata l
                 WHERE pg_has_role(w.who, l.lomowner, 'USAGE')
                    OR EXISTS (SELECT 1 FROM aclexplode(l.lomacl) a
                                WHERE a.privilege_type = 'UPDATE'
                                  AND (a.grantee = 0 OR pg_has_role(w.who, a.grantee, 'USAGE')))
                UNION ALL
                -- With lo_compat_privileges on, PostgreSQL checks no large-object privilege at all.
                SELECT 'PUBLIC', 'UPDATE on every large object (lo_compat_privileges is on)'
                 WHERE current_setting('lo_compat_privileges')::boolean
                UNION ALL
                SELECT grp, format('ownership of %s', CASE WHEN s.dbid IN (0, (SELECT oid FROM pg_database WHERE datname = current_database()))
                                                          THEN pg_describe_object(s.classid, s.objid, s.objsubid)
                                                          ELSE format('%s %s in database %s', s.classid::regclass, s.objid, s.dbid) END)
                  FROM pg_shdepend s
                 WHERE s.refclassid = 'pg_authid'::regclass AND s.refobjid = grp::regrole::oid AND s.deptype = 'o'
            ) f
            GROUP BY what
        ) g;
        IF bad IS NOT NULL THEN
            RAISE EXCEPTION 'read-only logins of % can change data in %: %. Their LOGIN stays off until a run passes. Sessions already open are not ended: end them with pg_terminate_backend (see the module README)', grp, db, bad;
        END IF;
        FOREACH op IN ARRAY ops LOOP
            EXECUTE format('ALTER ROLE %I LOGIN', op);
        END LOOP;
    END IF;
END
$fbx$;

COMMIT;
